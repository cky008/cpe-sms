# ==========================================
# H168-383 (5G CPE Ultra 6) 连接配置
# ==========================================
# CPE 管理后台地址（局域网或通过 Tailscale 暴露的内网路由地址）
CPE_URL=http://192.168.8.1
# CPE 登录用户名（H168-383 默认固定为 admin）
CPE_USERNAME=admin
# CPE 管理界面登录密码（必填）
CPE_PASSWORD=your_cpe_admin_password

# 默认国家/地区电话区号（默认 +353，可按需修改，如 +86、+44、+1、+852 等）
# 在 Telegram 引导式发短信、Web 网页发信及识别本地号码（如 083xxxxxxx -> +35383xxxxxxx）时默认生效
DEFAULT_COUNTRY_CODE=+353

# 容器时区（默认为 UTC，可按需修改为所在时区，如 UTC、Asia/Shanghai、Europe/London 等）
TZ=UTC

# ==========================================
# 🔐 本地落盘加密与安全配置（AES-256-GCM）
# ==========================================
# 用于加密本地持久化文件（state.json / sms-archive.json / contacts.json）的独立主密钥
# 若留空，默认自动使用 CPE_PASSWORD 经 scrypt + HKDF-SHA256 派生 AES-256-GCM 密钥加密落盘
DATA_ENCRYPTION_KEY=

# ==========================================
# Telegram Bot 配置
# ==========================================
# Telegram Bot Token（从 @BotFather 获取，必填以启用 TG 机器人）
TELEGRAM_API=1234567890:AAExampleBotTokenFromBotFather
# 允许访问机器人的 Telegram Chat ID（多个用英文逗号分隔）
# 可留空：首次在 Telegram 给机器人发送 `/auth <CPE_PASSWORD>` 即可自动完成安全绑定并加密持久化到 data/state.json
TELEGRAM_CHAT_IDS=
# Telegram API 地址（如在国内网络无代理环境可替换为反代地址）
TELEGRAM_API_BASE=https://api.telegram.org

# ==========================================
# 🌼 实时网页中心 & 统一 API（daisyUI 设计，高位端口，可选开启）
# ==========================================
# 是否开启实时短信网页与统一 API（true 开启 / false 关闭）
WEB_ENABLED=true
# 实时短信网页与 API 监听的高位端口（默认 18383，避免与 NAS 上 8080 等常用容器端口冲突）
WEB_PORT=18383
WEB_HOST=0.0.0.0

# ==========================================
# 轮询与短信归档配置
# ==========================================
# 免登录轻量检测新短信的轮询间隔（毫秒，默认 5000ms = 5秒，不会抢占浏览器后台登录态）
POLL_INTERVAL_MS=5000
# 空闲状态全量校验间隔（毫秒，默认 60000ms = 60秒，若检测到浏览器正登录 WebUI 会自动避让）
FULL_SYNC_INTERVAL_MS=60000
# 首次启动时是否将现有历史短信归档并标记为“已通知”以避免刷屏（默认 true）
SEED_EXISTING_ON_START=true
# 推送新短信通知后是否自动在 CPE 中标记为已读（默认 false）
AUTO_MARK_READ=false
# 状态、全量历史短信与本地通讯录持久化路径（均采用 AES-256-GCM 加密存储）
STATE_FILE=./data/state.json
ARCHIVE_FILE=./data/sms-archive.json
CONTACTS_FILE=./data/contacts.json

# ==========================================
# 可选：额外独立无头 HTTP API 端口与 Webhook 转发
# ==========================================
# 额外独立 REST API 端口（默认 0 关闭，因为 18383 已同时提供 Web 与完整 Bearer/Cookie API）
HTTP_PORT=0
HTTP_HOST=0.0.0.0
# Web 登录与 HTTP API 鉴权密码（若留空则默认复用 CPE_PASSWORD）
API_TOKEN=
# 可选：收到新短信时同步 POST JSON 到自定义 Webhook
WEBHOOK_URL=
